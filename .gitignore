# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ML / data
#
# D47: these MUST stay leading-slash anchored. Unanchored `data/` matches a directory
# named "data" at ANY depth, which silently excluded the entire src/omot/data package
# (MOTSequence, load_split, half_split_frames) from every commit since the repo was
# created — the checked-in tree could not `import omot.data` at all. Caught by running
# the sweep entrypoint from an unpacked bundle instead of the dev worktree, where the
# untracked files were present all along. tests/test_hpc_bundle.py guards it now.
/data/
/logs/
/runs/
/weights/
*.pth
*.pt
*.tar
*.onnx
*.engine
*.npz
!tests/fixtures/**/*.npz

# results: keep metric JSONs, ignore raw dumps
results/**/raw/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local
HARD_FAIL
gate_report.txt
*.mp4

viz/*.mp4

# D39 demo package: MOT17-derived clips stay untracked (dataset-derived, D37); the
# CARLA-only demo clip is synthetic content and IS committable (negated below).
demo/clips/
!demo/s5_carla.mp4

tools/

progress.txt
results/scaling_study.log

# D37 license hygiene: NO dataset-derived content (crops/images/frame dumps/
# serialized embeddings) in repo or any remote — loaders, manifests, SHA256s,
# download docs only. Enforced by tests/test_license_guard.py.
data/reid/
data/MOT20/
data/Market-1501/
*.jpg
*.jpeg
*.bmp
*.webp
viz/crops_*.png

# D42 wild-clip showcase: downloaded stock sources and rendered (source-derived)
# outputs are local-only by default; showcase/sources.md (the download manifest)
# stays trackable, so we ignore the specific subdirs, never the whole showcase/ dir.
showcase/sources/
showcase/renders/
results/sweep/**/*.log
results/sweep/*.log
results/sweep/**/submit.sbatch
results/sweep/**/submit_smoke.sbatch
results/sweep/**/logs/

# D47 HPC bundle: staged runtime assets and the built bundle are large binary
# artifacts reproducible from scripts/make_hpc_bundle.py -- never committed.
# (data/wheelhouse/ is already covered by the data/ rule above.)
assets/
dist/
